# ============================================
# Environment Variables Template
# 环境变量模板 - Copy to .env and fill in values
# ============================================

# --- sky-take-out (苍穹外卖) ---
# Database
SKY_DB_HOST=localhost
SKY_DB_PORT=3306
SKY_DB_NAME=sky_take_out
SKY_DB_USERNAME=root
SKY_DB_PASSWORD=<your-db-password>

# Redis
SKY_REDIS_HOST=192.168.150.101
SKY_REDIS_PORT=6379
SKY_REDIS_PASSWORD=<your-redis-password>
SKY_REDIS_DB=10

# JWT (change these in production!)
SKY_JWT_ADMIN_SECRET=<generate-a-random-secret>
SKY_JWT_USER_SECRET=<generate-a-random-secret>

# Alibaba Cloud OSS
SKY_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
SKY_OSS_KEY_ID=<your-oss-key-id>
SKY_OSS_KEY_SECRET=<your-oss-key-secret>
SKY_OSS_BUCKET=skyproject2

# WeChat Pay
SKY_WECHAT_APPID=<your-wechat-appid>
SKY_WECHAT_SECRET=<your-wechat-secret>
SKY_WECHAT_MCHID=<your-wechat-mchid>
SKY_WECHAT_MCH_SERIAL_NO=<your-wechat-mch-serial-no>
SKY_WECHAT_API_V3_KEY=<your-wechat-apiv3-key>
SKY_WECHAT_NOTIFY_URL=https://your-domain.com/wxpay/notify
SKY_WECHAT_REFUND_NOTIFY_URL=https://your-domain.com/wxpay/refund-notify

# Baidu Maps
SKY_BAIDU_AK=<your-baidu-ak>

# Shop
SKY_SHOP_ADDRESS=<your-shop-address>

# --- forum-master (文心论坛) ---
