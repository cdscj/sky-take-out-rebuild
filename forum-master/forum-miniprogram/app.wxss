/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 20rpx;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 15rpx 40rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  text-align: center;
  transition: all 0.3s;
}

.btn-primary {
  background-color: #07c160;
  color: #fff;
}

.btn-primary:hover {
  background-color: #06a856;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 文本样式 */
.text-center {
  text-align: center;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

/* 间距 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}