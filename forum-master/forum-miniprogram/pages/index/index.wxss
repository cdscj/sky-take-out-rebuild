/* 首页样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

/* 搜索框 */
.search-box {
  position: relative;
  margin-bottom: 20rpx;
}

.search-box input {
  width: 100%;
  padding: 20rpx 60rpx 20rpx 20rpx;
  border-radius: 30rpx;
  background-color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
}

/* 标签筛选 */
.label-container {
  margin-bottom: 20rpx;
}

.label-scroll {
  white-space: nowrap;
}

.label-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background-color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.label-item.active {
  background-color: #07c160;
  color: #fff;
}

/* 排序选项 */
.sort-container {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 20rpx 0;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.sort-item {
  font-size: 28rpx;
  color: #666;
}

.sort-item.active {
  color: #07c160;
  font-weight: bold;
}

/* 主题列表 */
.topic-list {
  margin-bottom: 20rpx;
}

.topic-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.topic-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.topic-content {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.username {
  margin-right: 20rpx;
}

.time {
  margin-right: 20rpx;
}

.reply-count {
  margin-right: 20rpx;
}

.view-count {
  margin-right: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 28rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 空数据提示 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #999;
}