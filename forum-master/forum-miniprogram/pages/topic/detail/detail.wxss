/* 主题详情页样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 主题信息 */
.topic-info {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.topic-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.topic-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.username {
  margin-right: 20rpx;
}

.time {
  margin-right: 20rpx;
}

.visit-count {
  margin-right: 20rpx;
}

/* 主题标签 */
.topic-labels {
  margin-bottom: 20rpx;
}

.label-item {
  display: inline-block;
  padding: 8rpx 16rpx;
  margin-right: 12rpx;
  background-color: #f0f0f0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #666;
}

/* 主题内容 */
.topic-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
}

/* 操作按钮 */
.topic-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}

/* 回复区域 */
.reply-section {
  background-color: #fff;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.reply-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 回复输入框 */
.reply-input-container {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 10rpx;
  margin-bottom: 30rpx;
}

.reply-input {
  flex: 1;
  background-color: transparent;
  padding: 15rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}

.reply-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  min-width: 100rpx;
}

.reply-btn::after {
  border: none;
}

/* 回复列表 */
.reply-list {
  margin-bottom: 20rpx;
}

.reply-item {
  display: flex;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.reply-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.reply-content {
  flex: 1;
}

.reply-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.reply-username {
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
}

.reply-time {
  font-size: 22rpx;
}

.reply-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

/* 回复操作 */
.reply-actions {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.reply-action {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
}

.reply-action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 子回复 */
.sub-replies {
  margin-top: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx;
}

.sub-reply-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.sub-reply-username {
  color: #333;
  font-weight: bold;
  margin-right: 10rpx;
}

.sub-reply-text {
  margin-right: 10rpx;
}

.sub-reply-time {
  font-size: 22rpx;
  color: #999;
}

/* 展开更多回复 */
.expand-replies {
  text-align: center;
  padding: 10rpx;
  font-size: 24rpx;
  color: #07c160;
  margin-top: 15rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999;
}