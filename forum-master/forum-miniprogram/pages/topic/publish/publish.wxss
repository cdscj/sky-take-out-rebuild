/* 发布主题页样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 表单组 */
.form-group {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 表单标签 */
.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

/* 标题输入 */
.title-input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 标签选择 */
.label-container {
  margin-bottom: 10rpx;
}

.label-scroll {
  white-space: nowrap;
}

.label-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.label-item.selected {
  background-color: #07c160;
  color: #fff;
}

/* 内容输入 */
.content-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  min-height: 300rpx;
  padding: 10rpx 0;
}

/* 字数统计 */
.word-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 发布按钮 */
.publish-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  padding: 20rpx;
  margin-top: 40rpx;
  margin-bottom: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
}

.publish-btn::after {
  border: none;
}

.publish-btn:disabled {
  background-color: #ccc;
  box-shadow: none;
}
