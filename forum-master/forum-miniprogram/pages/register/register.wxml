<!-- 注册/忘记密码页面 -->
<view class="container">
  <view class="form-container">
    <text class="title">{{isReset ? '忘记密码' : '注册账号'}}</text>
    
    <view class="form-item">
      <input class="input" placeholder="请输入手机号/邮箱" bindinput="onUsernameInput" value="{{username}}"></input>
    </view>
    
    <view class="form-item code-item">
      <input class="input code-input" placeholder="请输入验证码" bindinput="onCodeInput" value="{{code}}"></input>
      <button class="code-btn" bindtap="onGetCode" disabled="{{sendingCode}}">{{sendingCode ? countDown + 's后重试' : '获取验证码'}}</button>
    </view>
    
    <view class="form-item">
      <input class="input" type="password" placeholder="{{isReset ? '请输入新密码' : '请设置密码'}}" bindinput="onPasswordInput" value="{{password}}"></input>
    </view>
    
    <view class="form-item" wx:if="{{!isReset}}">
      <input class="input" type="password" placeholder="请确认密码" bindinput="onConfirmPasswordInput" value="{{confirmPassword}}"></input>
    </view>
    
    <button class="submit-btn" bindtap="onSubmit">{{isReset ? '重置密码' : '注册'}}</button>
    
    <view class="login-link">
      <text>{{isReset ? '已有账号？' : '已有账号？'}}</text>
      <text class="link" bindtap="onLoginTap">{{isReset ? '立即登录' : '立即登录'}}</text>
    </view>
  </view>
</view>