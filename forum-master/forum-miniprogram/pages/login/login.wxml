<!-- 登录页面 -->
<view class="container">
  <view class="login-form">
    <view class="logo-container">
      <image src="/images/logo.png" class="logo"></image>
      <text class="app-name">文心论坛</text>
    </view>
    
    <view class="form-item">
      <input class="input" placeholder="请输入手机号/邮箱" bindinput="onUsernameInput" value="{{username}}"></input>
    </view>
    
    <view class="form-item">
      <input class="input" type="password" placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}"></input>
      <image class="pwd-icon" src="/images/eye.png" bindtap="togglePasswordVisibility"></image>
    </view>
    
    <view class="form-item remember-me">
      <checkbox checked="{{rememberMe}}" bindtap="onRememberMeChange"></checkbox>
      <text class="remember-text">记住密码</text>
    </view>
    
    <button class="login-btn" bindtap="onLogin">登录</button>
    
    <view class="action-links">
      <text class="register-link" bindtap="onRegisterTap">立即注册</text>
      <text class="reset-pwd-link" bindtap="onResetPwdTap">忘记密码</text>
    </view>
  </view>
</view>