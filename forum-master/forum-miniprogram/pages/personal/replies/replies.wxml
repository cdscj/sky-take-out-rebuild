<!-- 我的回复页 -->
<view class="container">
  <!-- 空数据提示 -->
  <view wx:if="{{empty}}" class="empty-container">
    <image src="/images/empty.png" class="empty-image"></image>
    <text class="empty-text">暂无回复</text>
    <text class="empty-subtext">快去参与讨论吧</text>
    <navigator url="/pages/index/index" class="go-home-btn">
      去首页看看
    </navigator>
  </view>

  <!-- 回复列表 -->
  <view wx:else class="topic-list">
    <view wx:for="{{topics}}" wx:key="id" class="topic-item" bindtap="onTopicTap" data-id="{{item.id}}">
      <view class="topic-title">{{item.title}}</view>
      <view class="topic-content">{{item.topicContent}}</view>
      <view class="topic-meta">
        <text class="time">{{item.createTime}}</text>
        <text class="reply-count">{{item.replyNum || 0}}回复</text>
        <text class="view-count">{{item.visitNum || 0}}浏览</text>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore && !empty}}" class="load-more">加载更多</view>
</view>