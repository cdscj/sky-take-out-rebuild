<!-- 个人中心页 -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-info">
    <image src="{{userInfo.avatar || '/images/default-avatar.png'}}" class="avatar" mode="aspectFill"></image>
    <view class="user-detail">
      <view class="nickname">{{userInfo.userName || '未登录'}}</view>
      <view class="username">{{userInfo.userAccount || ''}}</view>
    </view>
    <button class="edit-btn" bindtap="onEditProfile">编辑资料</button>
  </view>
  
  <!-- 统计信息 -->
  <view class="stats">
    <view class="stat-item" bindtap="onMyTopics">
      <text class="stat-number">{{stats.topicCount || 0}}</text>
      <text class="stat-label">我的主题</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onMyReplies">
      <text class="stat-number">{{stats.replyCount || 0}}</text>
      <text class="stat-label">我的回复</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onMyFavorites">
      <text class="stat-number">{{stats.favoriteCount || 0}}</text>
      <text class="stat-label">我的收藏</text>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMyTopics">
      <view class="menu-left">
        <image src="/images/topic.png" class="menu-icon"></image>
        <text class="menu-text">我的主题</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
    <view class="menu-item" bindtap="onMyReplies">
      <view class="menu-left">
        <image src="/images/reply.png" class="menu-icon"></image>
        <text class="menu-text">我的回复</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
    <view class="menu-item" bindtap="onMyFavorites">
      <view class="menu-left">
        <image src="/images/favorite.png" class="menu-icon"></image>
        <text class="menu-text">我的收藏</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
    <view class="menu-item" bindtap="onMyFollowed">
      <view class="menu-left">
        <image src="/images/follow.png" class="menu-icon"></image>
        <text class="menu-text">我关注的</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
  </view>
  
  <view class="menu-section">
    <view class="menu-item" bindtap="onSettings">
      <view class="menu-left">
        <image src="/images/settings.png" class="menu-icon"></image>
        <text class="menu-text">设置</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <view class="menu-left">
        <image src="/images/about.png" class="menu-icon"></image>
        <text class="menu-text">关于</text>
      </view>
      <image src="/images/arrow-right.png" class="arrow-icon"></image>
    </view>
  </view>
  
  <!-- 退出登录按钮 -->
  <button class="logout-btn" bindtap="onLogout" wx:if="{{userInfo.id}}">退出登录</button>
  <button class="login-btn" bindtap="onLogin" wx:else>去登录</button>
</view>
