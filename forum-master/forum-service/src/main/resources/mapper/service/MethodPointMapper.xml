<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.net.wenxin.service.mapper.MethodPointMapper">

    <resultMap type="MethodPoint" id="MethodPointResult">
        <result property="id"    column="id"    />
        <result property="methodName"    column="method_name"    />
        <result property="methodPath"    column="method_path"    />
        <result property="name"    column="name"    />
        <result property="points"    column="points"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMethodPointVo">
        select id, method_name, method_path, name, points, status, del_flag, create_by, create_time, update_by, update_time from tb_method_point
    </sql>

    <select id="selectMethodPointList" parameterType="MethodPoint" resultMap="MethodPointResult">
        <include refid="selectMethodPointVo"/>
        <where>
            <if test="methodName != null  and methodName != ''"> and method_name like concat('%', #{methodName}, '%')</if>
            <if test="methodPath != null  and methodPath != ''"> and method_path = #{methodPath}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="points != null "> and points = #{points}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectMethodPointById" parameterType="Long" resultMap="MethodPointResult">
        <include refid="selectMethodPointVo"/>
        where id = #{id}
    </select>

    <insert id="insertMethodPoint" parameterType="MethodPoint" useGeneratedKeys="true" keyProperty="id">
        insert into tb_method_point
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="methodName != null">method_name,</if>
            <if test="methodPath != null and methodPath != ''">method_path,</if>
            <if test="name != null">name,</if>
            <if test="points != null">points,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="methodName != null">#{methodName},</if>
            <if test="methodPath != null and methodPath != ''">#{methodPath},</if>
            <if test="name != null">#{name},</if>
            <if test="points != null">#{points},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateMethodPoint" parameterType="MethodPoint">
        update tb_method_point
        <trim prefix="SET" suffixOverrides=",">
            <if test="methodName != null">method_name = #{methodName},</if>
            <if test="methodPath != null and methodPath != ''">method_path = #{methodPath},</if>
            <if test="name != null">name = #{name},</if>
            <if test="points != null">points = #{points},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMethodPointById" parameterType="Long">
        delete from tb_method_point where id = #{id}
    </delete>

    <delete id="deleteMethodPointByIds" parameterType="String">
        delete from tb_method_point where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>