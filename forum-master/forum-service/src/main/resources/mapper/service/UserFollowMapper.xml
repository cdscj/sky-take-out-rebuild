<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.net.wenxin.service.mapper.UserFollowMapper">
    
    <resultMap type="UserFollow" id="UserFollowResult">
        <result property="topicId"    column="topic_id"    />
        <result property="userId"    column="user_id"    />
    </resultMap>

    <sql id="selectUserFollowVo">
        select topic_id, user_id from tb_user_follow
    </sql>

    <select id="selectUserFollowList" parameterType="UserFollow" resultMap="UserFollowResult">
        <include refid="selectUserFollowVo"/>
        <where>  
        </where>
    </select>
    
    <select id="selectUserFollowByTopicId" parameterType="Long" resultMap="UserFollowResult">
        <include refid="selectUserFollowVo"/>
        where topic_id = #{topicId}
    </select>

    <select id="selectFollowByTopicIdAndUser" resultType="int">
        select count(*) from tb_user_follow
        where topic_id = #{topicId} and user_id = #{userName}
    </select>
        
    <insert id="insertUserFollow" parameterType="UserFollow">
        insert into tb_user_follow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="topicId != null">topic_id,</if>
            <if test="userId != null">user_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="topicId != null">#{topicId},</if>
            <if test="userId != null">#{userId},</if>
         </trim>
    </insert>

    <update id="updateUserFollow" parameterType="UserFollow">
        update tb_user_follow
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
        </trim>
        where topic_id = #{topicId}
    </update>

    <delete id="deleteUserFollowByTopicId" parameterType="Long">
        delete from tb_user_follow where topic_id = #{topicId}
    </delete>

    <delete id="deleteUserFollowByTopicIds" parameterType="String">
        delete from tb_user_follow where topic_id in 
        <foreach item="topicId" collection="array" open="(" separator="," close=")">
            #{topicId}
        </foreach>
    </delete>

    <delete id="deleteFollowByTopicIdAndUser" parameterType="UserFollow">
        delete from tb_user_follow where topic_id = #{topicId} and user_id = #{userId}
    </delete>
</mapper>