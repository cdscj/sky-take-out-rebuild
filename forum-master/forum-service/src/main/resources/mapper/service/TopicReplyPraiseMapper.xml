<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.net.wenxin.service.mapper.TopicReplyPraiseMapper">
    
    <resultMap type="TopicReplyPraise" id="TopicReplyPraiseResult">
        <result property="id"    column="id"    />
        <result property="topicId"    column="topic_id"    />
        <result property="replyId"    column="reply_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTopicReplyPraiseVo">
        select id, topic_id, reply_id, del_flag, create_by, create_time, update_by, update_time from tb_topic_reply_praise
    </sql>

    <select id="selectTopicReplyPraiseList" parameterType="TopicReplyPraise" resultMap="TopicReplyPraiseResult">
        <include refid="selectTopicReplyPraiseVo"/>
        <where>  
            <if test="topicId != null "> and topic_id = #{topicId}</if>
            <if test="replyId != null "> and reply_id = #{replyId}</if>
        </where>
    </select>
    
    <select id="selectTopicReplyPraiseById" parameterType="Long" resultMap="TopicReplyPraiseResult">
        <include refid="selectTopicReplyPraiseVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTopicReplyPraise" parameterType="TopicReplyPraise" useGeneratedKeys="true" keyProperty="id">
        insert into tb_topic_reply_praise
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="topicId != null">topic_id,</if>
            <if test="replyId != null">reply_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="topicId != null">#{topicId},</if>
            <if test="replyId != null">#{replyId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTopicReplyPraise" parameterType="TopicReplyPraise">
        update tb_topic_reply_praise
        <trim prefix="SET" suffixOverrides=",">
            <if test="topicId != null">topic_id = #{topicId},</if>
            <if test="replyId != null">reply_id = #{replyId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTopicReplyPraiseById" parameterType="Long">
        delete from tb_topic_reply_praise where id = #{id}
    </delete>

    <delete id="deleteTopicReplyPraiseByIds" parameterType="String">
        delete from tb_topic_reply_praise where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="unpraise" parameterType="TopicReplyPraise">
        delete from tb_topic_reply_praise
        where topic_id = #{topicId} and create_by = #{createBy}
        <if test="replyId != null"> and reply_id = #{replyId}</if>
    </delete>

    <select id="selectPraiseByTopicIdAndUser" resultType="int">
        select count(id) from tb_topic_reply_praise
        where topic_id = #{topicId} and create_by = #{userName}
    </select>
</mapper>