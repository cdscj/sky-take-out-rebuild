<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.net.wenxin.service.mapper.SensitivityMapper">
    
    <resultMap type="Sensitivity" id="SensitivityResult">
        <result property="id"    column="id"    />
        <result property="searchs"    column="searchs"    />
        <result property="replaces"    column="replaces"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSensitivityVo">
        select id, searchs, replaces, del_flag, create_by, create_time, update_by, update_time from tb_sensitivity
    </sql>

    <select id="selectSensitivityList" parameterType="Sensitivity" resultMap="SensitivityResult">
        <include refid="selectSensitivityVo"/>
        <where>
            del_flag != '2'
            <if test="searchs != null  and searchs != ''"> and searchs = #{searchs}</if>
            <if test="replaces != null  and replaces != ''"> and replaces = #{replaces}</if>
        </where>
    </select>
    
    <select id="selectSensitivityById" parameterType="Long" resultMap="SensitivityResult">
        <include refid="selectSensitivityVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSensitivity" parameterType="Sensitivity" useGeneratedKeys="true" keyProperty="id">
        insert into tb_sensitivity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="searchs != null and searchs != ''">searchs,</if>
            <if test="replaces != null">replaces,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="searchs != null and searchs != ''">#{searchs},</if>
            <if test="replaces != null">#{replaces},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSensitivity" parameterType="Sensitivity">
        update tb_sensitivity
        <trim prefix="SET" suffixOverrides=",">
            <if test="searchs != null and searchs != ''">searchs = #{searchs},</if>
            <if test="replaces != null">replaces = #{replaces},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSensitivityById" parameterType="Long">
        delete from tb_sensitivity where id = #{id}
    </delete>

    <delete id="deleteSensitivityByIds" parameterType="String">
        delete from tb_sensitivity where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>